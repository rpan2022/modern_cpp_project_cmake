    "clang-format.style": "Google",
    "clangd.arguments": [
        "--compile-commands-dir=build",
        "--background-index",
        "-j=4",
        "--clang-tidy",
        "--pretty",
        "--log=info"
    ],
    "clangd.checkUpdates": true,
    "clangd.enable": true,
